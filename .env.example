# SURAKSHA 365 – Women's Safety & Emergency Assistance Application - Environment Configuration
# Copy this file to .env.local for development

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Google Maps API (Optional - Leaflet & OpenStreetMap fallback enabled by default)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Emergency Gateway Integration (Cloud Functions Backend)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
POLICE_CAD_GATEWAY_URL=https://api.police.gov.in/cad/emergency-dispatch
